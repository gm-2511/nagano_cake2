<h1 class="text-center mb-4">商品詳細</h1>

<div style="display: flex; justify-content: center; gap: 40px; align-items: flex-start; flex-wrap: wrap;">

  <!-- 左側：商品画像 -->
  <div style="flex-shrink: 0;">
    <%= image_tag @item.get_image, 
                  alt: @item.name, 
                  style: "width: 300px; height: 300px; object-fit: cover; border: 1px solid #ccc; padding: 5px;" %>
  </div>

  <!-- 右側：商品情報 -->
  <div style="max-width: 400px;">
    <p><strong>商品名</strong></p>
    <p><%= @item.name %></p>

    <p><strong>商品説明</strong></p>
    <p><%= @item.introduction.presence || "説明はありません" %></p>

    <p><strong>ジャンル</strong></p>
    <p><%= @item.genre.name %></p>

    <p><strong>税込価格（税抜価格）</strong></p>
    <p>
      <%= number_to_currency(@item.with_tax_price, unit: "¥", precision: 0) %> 
      (<%= number_to_currency(@item.price, unit: "¥", precision: 0) %>)
    </p>

    <p><strong>販売ステータス</strong></p>
    <p style="color: <%= @item.is_active ? 'green' : 'red' %>;">
      <%= @item.is_active ? '販売中' : '販売停止中' %>
    </p>

    <%= link_to "編集する", edit_admin_item_path(@item), class: "btn btn-success mt-3" %>
  </div>

</div>
