<div class="container mt-4">
  <h3 class="mb-4">商品編集</h3>

  <%= form_with model: [:admin, @item], local: true do |f| %>

    <!-- 商品画像 -->
    <div class="mb-3">
      <label class="form-label">商品画像</label><br>
      <% if @item.image.attached? %>
        <div class="mb-2">
          <%= image_tag @item.image, style: "max-width: 200px; border: 1px solid #ccc; padding: 5px;" %>
        </div>
      <% end %>
      <%= f.file_field :image %>
    </div>

    <!-- 商品名 -->
    <div class="mb-3">
      <label class="form-label">商品名</label>
      <%= f.text_field :name, class: "form-control", value: @item.name %>
    </div>

    <!-- 商品説明 -->
    <div class="mb-3">
      <label class="form-label">商品説明</label>
      <%= f.text_area :introduction, rows: 5, class: "form-control" do %>
        <%= @item.introduction %>
      <% end %>
    </div>

    <!-- ジャンル -->
    <div class="mb-3">
      <label class="form-label">ジャンル</label>
      <%= f.collection_select :genre_id, @genres, :id, :name,
            { prompt: "選択してください--", selected: @item.genre_id },
            { class: "form-select" } %>
    </div>

    <!-- 税抜価格 -->
    <div class="mb-3">
      <label class="form-label">税抜価格</label>
      <div class="d-flex align-items-center">
        <%= f.number_field :price, class: "form-control w-25", value: @item.price %>
        <span class="ms-2">円</span>
      </div>
    </div>

    <!-- 販売ステータス -->
    <div class="mb-4">
      <label class="form-label">販売ステータス</label><br>

      <%= f.select :is_active, [["販売中", true], ["販売停止", false]], {}, class: "form-select" %>
    </div>

    <!-- 保存ボタン -->
    <%= f.submit "変更を保存", class: "btn btn-success" %>

  <% end %>
</div>
