<div class="container mt-4">
  <div class="d-flex justify-content-between align-items-center mb-3">
    <h2>商品一覧</h2>
    <%= link_to "+", new_admin_item_path, class: "btn btn-primary rounded-circle fs-4" %>
  </div>

  <table class="table table-bordered text-center align-middle">
    <thead class="table-light">
      <tr>
        <th>商品ID</th>
        <th>商品名</th>
        <th>税抜価格</th>
        <th>ジャンル</th>
        <th>ステータス</th>
      </tr>
    </thead>

    <tbody>
      <% @items.each do |item| %>
        <tr>
          <td><%= item.id %></td>
          <td>
            <%= link_to item.name, admin_item_path(item), class: "text-decoration-none" %>
          </td>
          <td><%= number_with_delimiter(item.price) %></td>
          <td><%= item.genre&.name %></td>
          <td>
            <% if item.is_active %>
              <span class="text-success fw-bold">販売中</span>
            <% else %>
              <span class="text-secondary fw-bold">販売停止中</span>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <div class="d-flex justify-content-center mt-4">
    <%= paginate @items %>
  </div>
</div>
