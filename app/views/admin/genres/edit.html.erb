<div class="container mt-4">
  <h3 class="mb-4">ジャンル編集</h3>

  <% if @genre.errors.any? %>
    <ul>
      <% @genre.errors.full_messages.each do |msg| %>
        <li><%= msg %></li>
      <% end %>
    </ul>
  <% end %>

  <%= form_with model: [:admin, @genre], local: true do |f| %>
    <div style="display: flex; align-items: center; flex-wrap: wrap; gap: 10px;">

      <!-- ジャンル名入力テキストボックス -->
      <%= f.text_field :name, class: "form-control", placeholder: "ジャンル名を入力", style: "width: 200px;" %>

      <!-- 保存ボタン -->
      <%= f.submit "変更を保存", class: "btn btn-success" %>

      <!-- 削除ボタン -->
      <%= link_to "削除", admin_genre_path(@genre), method: :delete, data: { confirm: "本当に削除しますか？" }, class: "btn btn-danger" %>

      <!-- 戻るボタン -->
      <%= link_to "戻る", admin_genres_path, class: "btn btn-secondary" %>

    </div>
  <% end %>
</div>
