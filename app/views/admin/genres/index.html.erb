<div class="container mt-4">
  <h2 class="mb-4">ジャンル一覧・追加</h2>

  <!-- 新規登録フォーム -->
  <div class="mb-5">
    <%= form_with model: [:admin, @genre], local: true do |f| %>
      <div class="d-flex gap-2 align-items-center">
        <%= f.text_field :name, class: "form-control w-50", placeholder: "ジャンル名" %>
        <%= f.submit "新規登録", class: "btn btn-success" %>
      </div>
    <% end %>
  </div>

  <!-- ジャンル一覧テーブル -->
  <table class="table table-bordered text-center">
    <thead class="table-light">
      <tr>
        <th>ジャンルID</th>
        <th>ジャンル名</th>
        <th>操作</th>
      </tr>
    </thead>

    <tbody>
      <% @genres.each do |genre| %>
        <tr>
          <td><%= genre.id %></td>
          <td><%= genre.name %></td>
          <td>
            <%= link_to "編集する", edit_admin_genre_path(genre), class: "btn btn-sm btn-primary" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
