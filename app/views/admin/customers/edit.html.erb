<!-- app/views/admin/customers/edit.html.erb -->
<div class="container mt-4">
  <h3 class="mb-4"><%= @customer.last_name %><%= @customer.first_name %>さんの会員情報編集</h3>

  <%= form_with model: [:admin, @customer], local: true do |f| %>
    <table class="table table-bordered">
      <tbody>
        <tr>
          <th class="bg-light w-25">会員ID</th>
          <td><%= @customer.id %></td>
        </tr>

        <tr>
          <th class="bg-light">氏名</th>
          <td>
            <div class="d-flex gap-2">
              <%= f.text_field :last_name, class: "form-control", placeholder: "姓" %>
              <%= f.text_field :first_name, class: "form-control", placeholder: "名" %>
            </div>
          </td>
        </tr>

        <tr>
          <th class="bg-light">フリガナ</th>
          <td>
            <div class="d-flex gap-2">
              <%= f.text_field :last_name_kana, class: "form-control", placeholder: "セイ" %>
              <%= f.text_field :first_name_kana, class: "form-control", placeholder: "メイ" %>
            </div>
          </td>
        </tr>

        <tr>
          <th class="bg-light">郵便番号</th>
          <td><%= f.text_field :postal_code, class: "form-control" %></td>
        </tr>

        <tr>
          <th class="bg-light">住所</th>
          <td><%= f.text_field :address, class: "form-control" %></td>
        </tr>

        <tr>
          <th class="bg-light">電話番号</th>
          <td><%= f.text_field :telephone_number, class: "form-control" %></td>
        </tr>

        <tr>
          <th class="bg-light">メールアドレス</th>
          <td><%= f.email_field :email, class: "form-control" %></td>
        </tr>

        <tr>
          <th class="bg-light">会員ステータス</th>
          <td>
            <%= f.select :is_active, [["有効", true], ["退会", false]], {}, class: "form-select" %>
          </td>
        </tr>
      </tbody>
    </table>

    <div class="mt-3">
      <%= f.submit "変更を保存", class: "btn btn-success" %>
    </div>
  <% end %>
</div>
