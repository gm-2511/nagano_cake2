<div class="container mt-4">

  <h3 class="mb-4">
    <%= @customer.last_name %><%= @customer.first_name %>さんの会員詳細
  </h3>

  <table class="table table-bordered">
    <tbody>
      <tr>
        <th class="bg-light w-25">会員ID</th>
        <td><%= @customer.id %></td>
      </tr>

      <tr>
        <th class="bg-light">氏名</th>
        <td>
          <%= @customer.last_name %> <%= @customer.first_name %>
        </td>
      </tr>

      <tr>
        <th class="bg-light">フリガナ</th>
        <td>
          <%= @customer.last_name_kana %> <%= @customer.first_name_kana %>
        </td>
      </tr>

      <tr>
        <th class="bg-light">郵便番号</th>
        <td><%= @customer.post_code %></td>
      </tr>

      <tr>
        <th class="bg-light">住所</th>
        <td><%= @customer.address %></td>
      </tr>

      <tr>
        <th class="bg-light">電話番号</th>
        <td><%= @customer.telephone_number %></td>
      </tr>

      <tr>
        <th class="bg-light">メールアドレス</th>
        <td><%= @customer.email %></td>
      </tr>

      <tr>
        <th class="bg-light">会員ステータス</th>
        <td>
          <% if @customer.is_active %>
            <span class="text-success fw-bold">有効</span>
          <% else %>
            <span class="text-secondary fw-bold">退会</span>
          <% end %>
        </td>
      </tr>
    </tbody>
  </table>

  <div class="mt-4 d-flex gap-3">
    <%= link_to "編集する", edit_admin_customer_path(@customer), class: "btn btn-success" %>

    <%= link_to "注文履歴一覧を見る", admin_customer_orders_path(@customer), class: "btn btn-primary" %>
  </div>

</div>
