<!DOCTYPE html>
<html>
  <head>
    <title>NaganoCake</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_pack_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%= javascript_pack_tag 'application', 'data-turbolinks-track': 'reload' %>
  </head>

  <body class="d-flex flex-column vh-100">
    <header>
      <nav class="navbar navbar-expand-lg navbar-light">
        <div class="container">
        <% if admin_signed_in? %>
          <%= image_tag 'nagano_cake_logo.png', size: '160x100' %>
        <% else %>
          <%= link_to root_path do %>
            <%= image_tag 'nagano_cake_logo.png', size: '160x100' %>
          <% end %>
        <% end %>
          <div class="collapse navbar-collapse">
            <ul class="navbar-nav ml-auto">
              <% if admin_signed_in? %>
                <li class="nav-item mx-4">
                  <%= link_to "商品一覧", admin_items_path, class: 'border border-primary rounded p-2' %>
                </li>
                <li class="nav-item mx-4">
                  <%= link_to "会員一覧", admin_customers_path, class: 'border border-primary rounded p-2' %>
                </li>
                <li class="nav-item mx-4">
                  <%= link_to "注文履歴一覧", admin_root_path, class: 'border border-primary rounded p-2' %>
                </li>
                <li class="nav-item mx-4">
                  <%= link_to "ジャンル一覧", admin_genres_path, class: 'border border-primary rounded p-2' %>
                </li>
                <li class="nav-item mx-4">
                  <%= link_to "ログアウト", destroy_admin_session_path, method: :delete, class: 'border border-primary rounded p-2' %>
                </li>
              <% elsif customer_signed_in? %>
                <li class="nav-item mx-4">
                  <%= link_to "マイページ", my_page_path, class: 'border border-primary rounded p-2' %>
                </li>
                <li class="nav-item mx-4">
                  <%= link_to "商品一覧", items_path, class: 'border border-primary rounded p-2' %>
                </li>
                <li class="nav-item mx-4">
                  <%= link_to "カート", cart_items_path, class: 'border border-primary rounded p-2' %>
                </li>
                <li class="nav-item mx-4">
                  <%= link_to "ログアウト", destroy_customer_session_path, method: :delete, class: 'border border-primary rounded p-2' %>
                </li>
              <% else %>
                <li class="nav-item mx-4">
                  <%= link_to "About", about_path, class: 'border border-primary rounded p-2' %>
                </li>
                <li class="nav-item mx-4">
                  <%= link_to "商品一覧", items_path, class: 'border border-primary rounded p-2' %>
                </li>
                <li class="nav-item mx-4">
                  <%= link_to "新規登録", new_customer_registration_path, class: 'border border-primary rounded p-2' %>
                </li>
                <li class="nav-item mx-4">
                  <%= link_to "ログイン", new_customer_session_path, class: 'border border-primary rounded p-2' %>
                </li>
              <% end %>
            </ul>
          </div>
        </div>
      </nav>
      <hr>
    </header>
    <main class="mb-auto">
    <%= yield %>
      <footer>
      <hr>
      </footer>
  </body>
</html>
