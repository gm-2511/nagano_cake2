<!DOCTYPE html>
<html>
  <head>
    <title>NaganoCake</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <script src="https://kit.fontawesome.com/8e86ac478f.js" crossorigin="anonymous"></script>
    <%= stylesheet_pack_tag 'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%= javascript_pack_tag 'application', 'data-turbolinks-track': 'reload' %>
  </head>

  <body class="d-flex flex-column vh-100">
    <header>
      <nav class="navbar navbar-expand-lg navbar-light">
        <div class="container">
        <% if admin_signed_in? %>
          <%= image_tag 'nagano_cake_logo.png', size: '160x100' %>
        <% else %>
          <%= link_to root_path do %>
            <%= image_tag 'nagano_cake_logo.png', size: '160x100' %>
          <% end %>
        <% end %>
        <div class="flex-grow-1 ms-3 mt-2 ml-5">
          <% if customer_signed_in? %>
            <span class="fw-bold">ようこそ、<%= current_customer.last_name %> さん！</span>
          <% end %>
        </div>
          <div class="collapse navbar-collapse d-flex flex-column align-items-end" id="navbarNav">
            <ul class="navbar-nav mb-2">
              <% if admin_signed_in? %>
                <li class="nav-item mx-4">
                  <%= link_to "商品一覧", admin_items_path, class: 'border border-primary rounded p-2' %>
                </li>
                <li class="nav-item mx-4">
                  <%= link_to "会員一覧", admin_customers_path, class: 'border border-primary rounded p-2' %>
                </li>
                <li class="nav-item mx-4">
                  <%= link_to "注文履歴一覧", admin_root_path, class: 'border border-primary rounded p-2' %>
                </li>
                <li class="nav-item mx-4">
                  <%= link_to "ジャンル一覧", admin_genres_path, class: 'border border-primary rounded p-2' %>
                </li>
                <li class="nav-item mx-4">
                  <%= link_to "ログアウト", destroy_admin_session_path, method: :delete, class: 'border border-primary rounded p-2' %>
                </li>
              <% elsif customer_signed_in? %>
                <li class="nav-item mx-4">
                  <%= link_to "マイページ", my_page_path, class: 'border border-primary rounded p-2' %>
                </li>
                <li class="nav-item mx-4">
                  <%= link_to "商品一覧", items_path, class: 'border border-primary rounded p-2' %>
                </li>
                <li class="nav-item mx-4">
                  <%= link_to "カート", cart_items_path, class: 'border border-primary rounded p-2' %>
                </li>
                <li class="nav-item mx-4">
                  <%= link_to "ログアウト", destroy_customer_session_path, method: :delete, class: 'border border-primary rounded p-2' %>
                </li>
              <% else %>
                <li class="nav-item mx-4">
                  <%= link_to "About", about_path, class: 'border border-primary rounded p-2' %>
                </li>
                <li class="nav-item mx-4">
                  <%= link_to "商品一覧", items_path, class: 'border border-primary rounded p-2' %>
                </li>
                <li class="nav-item mx-4">
                  <%= link_to "新規登録", new_customer_registration_path, class: 'border border-primary rounded p-2' %>
                </li>
                <li class="nav-item mx-4">
                  <%= link_to "ログイン", new_customer_session_path, class: 'border border-primary rounded p-2' %>
                </li>
              <% end %>
            </ul>
            <div class="search-form-container mt-3 mb-1 mr-4">
              <form class="d-flex border border-dark bg-white align-items-center" style="width: 220px; height: 32px; position: relative;">
                <input class="form-control form-control-sm border-0 shadow-none px-2" type="search" placeholder="Search" style="border-radius: 0; height: 100%; width: 100%; padding-right: 35px;">
                <div style="position: absolute; right: 8px; display: flex; align-items: center; pointer-events: none;">
                  <i class="fa fa-search text-dark" aria-hidden="true" style="font-size: 0.9rem;"></i>
                </div>
              </form>
            </div>
          </div>
        </div>
      </nav>
      <hr>
    </header>
    <main class="mb-auto">
      <div class="container mt-3">
        <% unless admin_signed_in? %>
          <% flash.each do |message_type, message| %>
            <div class="alert alert-<%= message_type == 'notice' ? 'success' : 'danger' %>">
              <%= message %>
            </div>
          <% end %>
        <% end %>
      </div>
        <%= yield %>
      <footer>
        <hr>
      </footer>
  </body>
</html>
