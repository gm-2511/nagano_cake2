<div class="container mt-5">
  <div class="row">
    <div class="col-md-10 offset-md-1">
      
      <h4 class="bg-light d-inline-block px-4 py-1 mb-5" style="background-color: #d3d3d3 !important;">配送先編集</h4>

      <%= form_with model: @address, url: address_path(@address), method: :patch, local: true do |f| %>
        
        <div class="row mb-3 align-items-center">
          <%= f.label :post_code, "郵便番号(ハイフンなし)", class: "col-md-3 col-form-label" %>
          <div class="col-md-3">
            <%= f.text_field :post_code, class: "form-control" %>
          </div>
        </div>

        <div class="row mb-3 align-items-center">
          <%= f.label :address, "住所", class: "col-md-7 col-form-label" %>
          <div class="col-md-7">
            <%= f.text_field :address, class: "form-control" %>
          </div>
        </div>

        <div class="row mb-5 align-items-center">
          <%= f.label :name, "宛名", class: "col-md-3 col-form-label" %>
          <div class="col-md-3">
            <%= f.text_field :name, class: "form-control" %>
          </div>
          <div class="col-md-4 text-end offset-md-1">
            <%= f.submit "変更内容を保存", class: "btn btn-success px-4 fw-bold" %>
          </div>
        </div>
        
      <% end %>

    </div>
  </div>
</div>