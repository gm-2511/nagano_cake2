<div class="container mt-5">
  <div class="row">
    <div class="col-md-10 offset-md-1">
      
      <h4 class="bg-light d-inline-block px-4 py-1 mb-5">配送先登録 / 一覧</h4>

      <% if @address.errors.any? %>
        <div class="alert alert-danger">
          <ul>
            <% @address.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form_with model: @address, url: addresses_path, local: true do |f| %>
        <div class="row mb-3 align-items-center">
          <%= f.label :post_code, "郵便番号(ハイフンなし)", class: "col-md-3 col-form-label" %>
          <div class="col-md-3">
            <%= f.text_field :post_code, class: "form-control" %>
          </div>
        </div>

        <div class="row mb-3 align-items-center">
          <%= f.label :address, "住所", class: "col-md-3 col-form-label" %>
          <div class="col-md-6">
            <%= f.text_field :address, class: "form-control" %>
          </div>
        </div>

        <div class="row mb-5 align-items-center">
          <%= f.label :name, "宛名", class: "col-md-3 col-form-label" %>
          <div class="col-md-3">
            <%= f.text_field :name, class: "form-control" %>
          </div>
          <div class="col-md-3 offset-md-3 text-end">
            <%= f.submit "新規登録", class: "btn btn-success px-4" %>
          </div>
        </div>
      <% end %>

      <table class="table table-bordered border-dark mt-5">
        <thead class="bg-light">
          <tr>
            <th style="width: 15%;">郵便番号</th>
            <th style="width: 45%;">住所</th>
            <th style="width: 20%;">宛名</th>
            <th style="width: 20%;"></th>
          </tr>
        </thead>
        <tbody>
          <% @addresses.each do |address| %>
            <tr>
              <td class="align-middle"><%= address.post_code %></td>
              <td class="align-middle"><%= address.address %></td>
              <td class="align-middle text-nowrap"><%= address.name %></td>
              <td class="text-center align-middle">
                <%= link_to "編集する", edit_address_path(address), class: "btn btn-success btn-sm me-2" %>
                <%= link_to "削除する", address_path(address), method: :delete, class: "btn btn-danger btn-sm", "data-confirm" => "本当に削除しますか？" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>

    </div>
  </div>
</div>