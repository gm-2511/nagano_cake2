<div class="container mt-5">
  <div class="row">
    <div class="col-md-10 offset-md-1">
      
      <h4 class="bg-light d-inline-block px-4 py-1 mb-5" style="background-color: #d3d3d3 !important;">新規会員登録</h4>

      <%= form_with model: @customer, url: customer_registration_path, local: true do |f| %>
        <%= render "public/shared/error_messages", resource: resource %>

        <div class="row mb-3 align-items-center">
          <label class="col-md-3 col-form-label">名前</label>
          <div class="col-md-1 text-end"><small>(姓)</small></div>
          <div class="col-md-3">
            <%= f.text_field :last_name, autofocus: true, class: "form-control" %>
          </div>
          <div class="col-md-1 text-end"><small>(名)</small></div>
          <div class="col-md-3">
            <%= f.text_field :first_name, class: "form-control" %>
          </div>
        </div>

        <div class="row mb-3 align-items-center">
          <label class="col-md-3 col-form-label">フリガナ</label>
          <div class="col-md-1 text-end"><small>(セイ)</small></div>
          <div class="col-md-3">
            <%= f.text_field :last_name_kana, class: "form-control" %>
          </div>
          <div class="col-md-1 text-end"><small>(メイ)</small></div>
          <div class="col-md-3">
            <%= f.text_field :first_name_kana, class: "form-control" %>
          </div>
        </div>

        <div class="row mb-3 align-items-center">
          <%= f.label :email, "メールアドレス", class: "col-md-3 col-form-label" %>
          <div class="col-md-1"></div>
          <div class="col-md-4">
            <%= f.email_field :email, class: "form-control" %>
          </div>
        </div>

        <div class="row mb-3 align-items-center">
          <%= f.label :post_code, "郵便番号(ハイフンなし)", class: "col-md-3 col-form-label" %>
          <div class="col-md-1"></div>
          <div class="col-md-4">
            <%= f.text_field :post_code, class: "form-control" %>
          </div>
        </div>

        <div class="row mb-3 align-items-center">
          <%= f.label :address, "住所", class: "col-md-3 col-form-label" %>
          <div class="col-md-1"></div>
          <div class="col-md-7">
            <%= f.text_field :address, class: "form-control" %>
          </div>
        </div>

        <div class="row mb-3 align-items-center">
          <%= f.label :telephone_number, "電話番号(ハイフンなし)", class: "col-md-3 col-form-label" %>
          <div class="col-md-1"></div>
          <div class="col-md-4">
            <%= f.text_field :telephone_number, class: "form-control" %>
          </div>
        </div>

        <div class="row mb-3 align-items-center">
          <%= f.label :password, "パスワード(6文字以上)", class: "col-md-3 col-form-label" %>
          <div class="col-md-1"></div>
          <div class="col-md-4">
            <%= f.password_field :password, class: "form-control" %>
          </div>
        </div>

        <div class="row mb-4 align-items-center">
          <%= f.label :password_confirmation, "パスワード(確認用)", class: "col-md-3 col-form-label" %>
          <div class="col-md-1"></div>
          <div class="col-md-4">
            <%= f.password_field :password_confirmation, class: "form-control" %>
          </div>
        </div>

        <div class="row mb-5">
          <div class="col-md-4 offset-md-4">
            <%= f.submit "新規登録", class: "btn btn-success px-5 w-100 fw-bold" %>
          </div>
        </div>

        <div class="row">
          <div class="col-md-10 offset-md-1">
            <h5 class="bg-light d-inline-block px-3 py-1 mb-3" style="background-color: #d3d3d3 !important;">既に登録済みの方</h5>
            <p class="ms-4">
              <%= link_to "こちら", new_customer_session_path %> からログインしてください。
            </p>
          </div>
        </div>
        
      <% end %>

    </div>
  </div>
</div>
