<div class="container mt-5">
  <div class="row justify-content-center">
    <div class="col-md-9">

      <div class="text-center mb-5">
        <h4 class="bg-light d-inline-block px-5 py-1 border text-secondary">マイページ</h4>
      </div>

      <div class="d-flex align-items-center mb-3">
        <h5 class="fw-bold mb-0 me-4">登録情報</h5>
        <%= link_to '編集する', edit_customer_path, class: 'btn btn-success px-4 py-1' %>
      </div>

      <table class="table table-bordered border-dark">
        <tbody>
          <tr>
            <th class="bg-light w-25">氏名</th>
            <td><%= @customer.last_name %> <%= @customer.first_name %></td>
          </tr>
          <tr>
            <th class="bg-light">カナ</th>
            <td><%= @customer.last_name_kana %> <%= @customer.first_name_kana %></td>
          </tr>
          <tr>
            <th class="bg-light">郵便番号</th>
            <td><%= @customer.post_code %></td>
          </tr>
          <tr>
            <th class="bg-light">住所</th>
            <td><%= @customer.addredd %></td> </tr>
          <tr>
            <th class="bg-light">電話番号</th>
            <td><%= @customer.telephone_number %></td>
          </tr>
          <tr>
            <th class="bg-light">メールアドレス</th>
            <td><%= @customer.email %></td>
          </tr>
        </tbody>
      </table>

      <div class="mt-5">
        <div class="d-flex align-items-center mb-4">
          <h5 class="fw-bold mb-0" style="width: 120px;">配送先</h5>
          <%= link_to '一覧を見る', addresses_path, class: 'btn btn-primary px-4' %>
        </div>
        <div class="d-flex align-items-center mb-4">
          <h5 class="fw-bold mb-0" style="width: 120px;">注文履歴</h5>
          <%= link_to '一覧を見る', orders_path, class: 'btn btn-primary px-4' %>
        </div>
      </div>

    </div>
  </div>
</div>
