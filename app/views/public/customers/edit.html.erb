<div class="container mt-5">
  <div class="row">
    <div class="col-md-10 offset-md-1">
      
      <h4 class="bg-light d-inline-block px-4 py-1 mb-5" style="background-color: #d3d3d3">会員情報編集</h4>

      <%= form_with model: @customer, url: update_information_path, method: :patch, local: true do |f| %>
        
        <div class="row mb-3">
          <label class="col-md-3 col-form-label">氏名</label>
          <div class="col-md-3">
            <%= f.text_field :last_name, class: "form-control" %>
          </div>
          <div class="col-md-3">
            <%= f.text_field :first_name, class: "form-control" %>
          </div>
        </div>

        <div class="row mb-3">
          <label class="col-md-3 col-form-label">フリガナ</label>
          <div class="col-md-3">
            <%= f.text_field :last_name_kana, class: "form-control" %>
          </div>
          <div class="col-md-3">
            <%= f.text_field :first_name_kana, class: "form-control" %>
          </div>
        </div>

        <div class="row mb-3">
          <label class="col-md-3 col-form-label">郵便番号</label>
          <div class="col-md-3">
            <%= f.text_field :post_code, class: "form-control" %>
          </div>
        </div>

        <div class="row mb-3">
          <label class="col-md-3 col-form-label">住所</label>
          <div class="col-md-8">
            <%= f.text_field :address, class: "form-control" %>
          </div>
        </div>

        <div class="row mb-3">
          <label class="col-md-3 col-form-label">電話番号</label>
          <div class="col-md-3">
            <%= f.text_field :telephone_number, class: "form-control" %>
          </div>
        </div>

        <div class="row mb-4">
          <label class="col-md-3 col-form-label">メールアドレス</label>
          <div class="col-md-3">
            <%= f.email_field :email, class: "form-control" %>
          </div>
        </div>

        <div class="row mt-5">
          <div class="col-md-3 offset-md-3">
            <%= f.submit "編集内容を保存", class: "btn btn-success px-5 fw-bold w-100" %>
          </div>
          <div class="col-md-2 offset-md-2">
            <%= link_to "退会する", unsubscribe_path, class: "btn btn-danger px-4 fw-bold w-100" %>
          </div>
        </div>
        
      <% end %>

    </div>
  </div>
</div>