<div class="container mt-5">
  <div class="row">
    <div class="col-md-10 offset-md-1">

      <h4 class="bg-light d-inline-block px-4 py-1 mb-5" style="background-color: #d3d3d3 !important;">ログイン</h4>

      <div class="ms-5 mb-4">
        <h5 class="bg-light d-inline-block px-3 py-1" style="background-color: #d3d3d3 !important;">会員の方は、こちらからログイン</h5>
      </div>

      <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
        
        <div class="row mb-3 justify-content-center">
          <%= f.label :email, "メールアドレス", class: "col-md-3 col-form-label offset-md-1" %>
          <div class="col-md-6">
            <%= f.email_field :email, autofocus: true, autocomplete: "email", class: "form-control" %>
          </div>
        </div>

        <div class="row mb-4 justify-content-center">
          <%= f.label :password, "パスワード", class: "col-md-3 col-form-label offset-md-1" %>
          <div class="col-md-6">
            <%= f.password_field :password, autocomplete: "current-password", class: "form-control" %>
          </div>
        </div>

        <div class="row mb-5">
          <div class="col-md-6 offset-md-4 text-start">
            <%= f.submit "ログイン", class: "btn btn-primary px-5" %>
          </div>
        </div>

      <% end %>

      <div class="ms-5 mt-5">
        <h5 class="bg-light d-inline-block px-3 py-1 mb-3" style="background-color: #d3d3d3 !important;">会員登録がお済みでない方</h5>
        <p class="ms-5">
          <%= link_to "こちら", new_customer_registration_path %> から新規登録を行ってください。
        </p>
      </div>

    </div>
  </div>
</div>
