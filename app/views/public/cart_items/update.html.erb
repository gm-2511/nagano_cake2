<div class="container my-5">
  <div class="row">
    <div class="col-md-10 offset-md-1">
      
      <h2 class="mb-4 d-inline-block border-bottom border-dark">ショッピングカート</h2>
      
  # 【一括削除ボタン】ワイヤーフレーム右上の赤いボタン 
      <%= link_to 'カートを空にする', destroy_all_cart_items_path, method: :delete, data: { confirm: '本当にカートを全て空にしますか？' }, class: 'btn btn-danger float-right' %>

      <% if @cart_items.empty? %>
        <p class="alert alert-info">カートに商品はありません。</p>
      <% else %>
        <table class="table table-bordered">
          <thead>
            <tr class="table-secondary">
              <th>商品名</th>
              <th>単価(税込)</th>
              <th style="width: 150px;">数量</th>
              <th>小計</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% @total_price = 0 %> <%# 合計金額の初期化 %>
            <% @cart_items.each do |cart_item| %>
              <% item = cart_item.item %>
              <% subtotal = item.price * 1.1 * cart_item.amount %>
              <% @total_price += subtotal %>
              
              <tr>
                <td><%= item.name %></td>
                <td><%= (item.price * 1.1).to_i.to_s(:delimited) %></td> <%# 税込価格をカンマ区切りで表示 %>

                <%# 数量変更フォーム %>
                <td>
                  <%= form_with model: cart_item, url: cart_item_path(cart_item), method: :patch, class: "d-flex align-items-center" do |f| %>
                    
                    <%# 数量入力フィールド %>
                    <%= f.number_field :amount, min: 1, class: "form-control text-center mr-2", style: "width: 70px;" %>
                    
                    <%# 変更ボタン %>
                    <%= f.submit "変更", class: "btn btn-success btn-sm ml-2" %>
                  <% end %>
                </td>

                <td><%= subtotal.to_i.to_s(:delimited) %></td> <%# 小計をカンマ区切りで表示 %>
                
                <%# 個別削除ボタン %>
                <td>
                  <%= link_to '削除する', cart_item_path(cart_item), method: :delete, data: { confirm: '本当に削除しますか？' }, class: 'btn btn-danger btn-sm' %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
        
        <div class="row">
          <div class="col-md-6">
            <%# 買い物を続けるボタン %>
            <%= link_to '買い物を続ける', items_path, class: 'btn btn-primary' %>
          </div>
          
          <div class="col-md-6">
            <table class="table table-bordered float-right w-50">
              <tr>
                <th class="table-secondary">合計金額</th>
                <td>
                  <strong class="text-danger"><%= @total_price.to_i.to_s(:delimited) %></strong>
                </td>
              </tr>
            </table>
          </div>
        </div>

  #  【情報入力に進むボタン】ワイヤーフレーム最下部のボタン 
        <div class="text-center mt-5">
          <%# 注文情報入力ページへのリンク (ルートは適宜変更してください) %>
          <%= link_to '情報入力に進む', new_order_path, class: 'btn btn-success btn-lg px-5' %> 
        </div>
      <% end %>
      
    </div>
  </div>
</div>