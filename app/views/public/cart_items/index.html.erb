<div class="container my-5 px-5 px-sm-0">
  <div class="row">
    <div class="col-md-10 offset-md-1">
      
      <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="bg-light d-inline-block px-3 mb-0">ショッピングカート</h2>
        <%= link_to 'カートを空にする', destroy_all_cart_items_path, method: :delete, data: { confirm: '本当にカートを全て空にしますか？' }, class: 'btn btn-danger btn-sm' %>
      </div>

      <% if @cart_items.empty? %>
        <p class="alert alert-info">カートに商品はありません。</p>
      <% else %>
        <table class="table table-bordered border-dark">
          <thead class="bg-light text-dark">
            <tr>
              <th style="width: 40%">商品名</th>
              <th>単価(税込)</th>
              <th style="width: 150px;">数量</th>
              <th>小計</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            <% @total_price = 0 %>
            <% @cart_items.each do |cart_item| %>
              <% item = cart_item.item %>
              <% subtotal = item.with_tax_price * cart_item.amount %>
              <% @total_price += subtotal %>
              
              <tr>
                <td class="align-middle">
                  <div class="d-flex align-items-center">
                    <%= image_tag item.get_image, class: "img-fluid border mr-3", style: "width: 80px; height: 60px; object-fit: cover;" %>
                    <span class="font-weight-bold" style="font-size: 1.1rem;"><%= item.name %></span>
                  </div>
                </td>
                <td class="align-middle"><%= item.with_tax_price.to_s(:delimited) %></td>

                <td class="align-middle">
                  <%= form_with model: cart_item, url: cart_item_path(cart_item), method: :patch, class: "d-flex align-items-center" do |f| %>
                    <%= f.number_field :amount, min: 1, class: "form-control text-center mr-2", style: "width: 70px;" %>
                    <%= f.submit "変更", class: "btn btn-success btn-sm ml-1" %>
                  <% end %>
                </td>

                <td class="align-middle"><%= subtotal.to_s(:delimited) %></td>
                
                <td class="text-center align-middle"">
                  <%= link_to '削除する', cart_item_path(cart_item), method: :delete, data: { confirm: '本当に削除しますか？' }, class: 'btn btn-danger btn-sm' %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
        
        <div class="row mt-4">
          <div class="col-md-7">
            <%= link_to '買い物を続ける', items_path, class: 'btn btn-primary' %>
          </div>
          
          <div class="col-md-5">
            <table class="table table-bordered border-dark">
              <tr>
                <th class="bg-light text-dark w-50">合計金額</th>
                <td class="font-weight-bold"><%= @total_price.to_s(:delimited) %>円</td>
              </tr>
            </table>
          </div>
        </div>

        <div class="text-center mt-5">
          <%= link_to '情報入力に進む', new_order_path, class: 'btn btn-success btn-lg px-5' %> 
        </div>
      <% end %>
      
    </div>
  </div>
</div>