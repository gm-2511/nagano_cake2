<div class="col-md-3 mb-4">
  <%= link_to item_path(item) do %>
    <div class="card border-0">
      <%= image_tag item.get_image, class: 'w-100 h-100', style: 'object-fit: cover;' %>
      <div class="card-body px-0 pb-0">
        <p class="card-title text-dark"><strong><%= item.name %></strong></p>
        <p class="card-text text-dark">¥<%= item.price.to_s(:delimited) %></p>
      </div>
    </div>
  <% end %>
</div>