<div class="col-md-3 pr-md-5">
  <table class="table table-bordered border-dark table-hover">
    <thead>
      <tr>
        <th class="bg-light text-center">ジャンル検索</th>
      </tr>
    </thead>
    <tbody>
      <% genres.each do |genre| %>
        <tr>
          <td class="p-0">
            <%= link_to genre.name, items_path(genre_id: genre.id), class: "text-dark d-block w-100 py-2 pl-3" %>
          </td>
        </tr>
      <% end %>
      <tr>
        <td class="p-0">
          <%= link_to "全商品", items_path, class: "text-dark d-block w-100 py-2 pl-3" %>
        </td>
      </tr>
    </tbody>
  </table>
</div>