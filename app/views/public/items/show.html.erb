<div class="container my-5">
  <div class="row">
    
    <div class="col-md-3">
      <h4>ジャンル検索</h4>
      <%# ナビゲーション担当の方の実装待ちのため、箱だけを用意 %>
      <div class="list-group">
        <a href="#" class="list-group-item list-group-item-action active">
          [ジャンルA]
        </a>
        <a href="#" class="list-group-item list-group-item-action">
          [ジャンルB]
        </a>
        <a href="#" class="list-group-item list-group-item-action">
          [ジャンルC]
        </a>
      </div>
    </div>
    
    <div class="col-md-9">
      
      <% if @item.present? %>
        <h2 class="mb-4"><%= @item.name %></h2>

        <div class="row">
          <div class="col-md-5">
            <% if @item.image.attached? %>
              <%= image_tag @item.image, alt: @item.name, class: "img-fluid" %>
            <% else %>
              <img src="https://via.placeholder.com/300" alt="<%= @item.name %>" class="img-fluid">
            <% end %>
          </div>
          
          <div class="col-md-7">
            <table class="table table-borderless">
              <tbody>
                <tr>
                  <th scope="row" class="w-25">商品説明</th>
                  <td><%= @item.introduction %></td>
                </tr>
                <tr>
                  <th scope="row">価格</th>
                  <td>
                    <span class="h4 text-danger">
                      ¥<%= (@item.price * 1.1).to_i.to_s(:delimited) %> 
                    </span>
                    <span class="small">(税込)</span>
                  </td>
                </tr>
                <tr>
                  <th scope="row">ジャンル</th>
                  <td>
                    <%= @item.genre.name %>
                  </td>
                </tr>
              </tbody>
            </table>

            <div class="mt-4">
              <%= form_with model: @cart_item, url: cart_items_path, class: "row g-3 align-items-center" do |f| %>
                <div class="col-auto">
                  <%= f.label :amount, "個数選択", class: "col-form-label" %>
                </div>
                <div class="col-auto">
                  <%= f.number_field :amount, id: "quantity", class: "form-control", style: "width: 100px;", value: 1, min: 1 %>
                </div>

                <%= f.hidden_field :item_id, value: @item.id %>

                <div class="col-auto">
                  <%= f.button :submit, class: 'btn btn-success btn-lg' do %>
                    カートに入れる
                  <% end %>
                </div>
              <% end %>
            </div>
          </div>
        </div>
      <% else %>
        <p class="alert alert-warning">指定された商品が見つかりませんでした。</p>
      <% end %>
      
    </div>
  </div>
</div>