<div class="container my-5">
  <div class="row">
    
    <%= render 'public/items/genre_search', genres: @genres %>
    
    <div class="col-md-9">
      <h2 class="bg-light d-inline-block px-3 mb-4">
        <%= @genre_name %> 一覧
        <span class="small">(全<%= @items.total_count %>件)</span>
      </h2>

      <div class="row">
        <%= render partial: 'public/items/item_card', collection: @items, as: :item %>
      </div>

      <div class="d-flex justify-content-center mt-4">
        <%= paginate @items %>
      </div>
      
    </div>
  </div>
</div>