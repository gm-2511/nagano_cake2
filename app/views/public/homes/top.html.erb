<div class="container mt-5">
  <div class="row">
    <div class="col-md-3">
      <table class="table table-bordered">
        <thead class="bg-light">
          <tr><th class="text-center">ジャンル検索</th></tr>
        </thead>
        <tbody>
          <% @genres.each do |genre| %>
            <tr>
              <td class="px-3">
                <%= link_to genre.name, items_path(genre_id: genre.id), class: "text-dark text-decoration-none" %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <div class="col-md-9">
      <div class="mb-5 d-flex justify-content-center align-items-center" 
           style="height: 350px; 
                  background-image: url(<%= asset_path('top_background_img.png') %>); 
                  background-size: contain;
                  background-position: center;">
        
        <div class="text-center text-dark fw-bold" style="text-shadow: 1px 1px 2px white;">
          <p class="mb-2 h5">ようこそ、ながのCAKEへ！</p>
          <p class="mb-2">このサイトは、ケーキ販売のECサイトになります。</p>
          <p class="mb-0">会員でない方も商品の閲覧はできますが、<br>購入には会員登録が必要になります。</p>
        </div>
      </div>

      <h3 class="mb-4">新着商品</h3>
      <div class="row">
        <% @items.each do |item| %>
          <div class="col-md-3 mb-4">
            <div class="border mb-2" style="height: 150px; background-color: #eee;">
              <%= image_tag item.get_image, class: 'w-100 h-100', style: 'object-fit: cover;' %>
            </div>
            <p class="mb-1 fw-bold text-truncate"><%= item.name %></p>
            <p class="mb-0">¥<%= item.with_tax_price.to_s(:delimited) %></p>
          </div>
        <% end %>
      </div>

      <div class="text-end mt-3">
        <%= link_to "全ての商品を見る >", items_path, class: "text-primary text-decoration-none" %>
      </div>
    </div>
  </div>
</div>
