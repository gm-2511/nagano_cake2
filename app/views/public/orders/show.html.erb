<div class="container px-5 px-sm-0">
  <div class="row">
    <div class="col-md-11 offset-md-1">
      <h2 class="bg-light d-inline-block px-3 mb-4">注文詳細</h2>

      <div class="row mb-4">
        <div class="col-md-7">
          <h5 class="font-weight-bold">注文情報</h5>
          <table class="table table-bordered border-dark">
            <tr>
              <th class="bg-light text-dark w-25">注文日</th>
              <td><%= @order.created_at.strftime('%Y/%m/%d') %></td>
            </tr>
            <tr>
              <th class="bg-light text-dark">配送先</th>
              <td>
                〒<%= @order.post_code %><br>
                <%= @order.address %><br>
                <%= @order.name %>
              </td>
            </tr>
            <tr>
              <th class="bg-light text-dark">支払方法</th>
              <td><%= @order.payment_method_i18n %></td>
            </tr>
            <tr>
              <th class="bg-light text-dark">ステータス</th>
              <td><%= @order.status_i18n %></td>
            </tr>
          </table>
        </div>

        <div class="col-md-4">
          <h5 class="font-weight-bold">請求情報</h5>
          <table class="table table-bordered border-dark">
            <tr>
              <th class="bg-light text-dark w-50">商品合計</th>
              <td><%= (@order.total_payment - @order.shipping_cost).to_s(:delimited) %>円</td>
            </tr>
            <tr>
              <th class="bg-light text-dark">配送料</th>
              <td><%= @order.shipping_cost.to_s(:delimited) %>円</td>
            </tr>
            <tr>
              <th class="bg-light text-dark font-weight-bold">ご請求額</th>
              <td class="font-weight-bold"><%= @order.total_payment.to_s(:delimited) %>円</td>
            </tr>
          </table>
        </div>
      </div>

      <div class="row">
        <div class="col-md-9">
          <h5 class="font-weight-bold">注文内容</h5>
          <table class="table table-bordered border-dark">
            <thead class="bg-light text-dark">
              <tr>
                <th>商品</th>
                <th>単価（税込）</th>
                <th>個数</th>
                <th>小計</th>
              </tr>
            </thead>
            <tbody>
              <% @order_details.each do |order_detail| %>
                <tr>
                  <td><%= order_detail.item.name %></td>
                  <td><%= order_detail.price.to_s(:delimited) %>円</td>
                  <td><%= order_detail.amount %></td>
                  <td><%= (order_detail.price * order_detail.amount).to_s(:delimited) %>円</td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>