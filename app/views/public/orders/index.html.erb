<div class="container px-5 px-sm-0">
  <div class="row">
    <div class="col-md-10 offset-md-1">
      <h2 class="bg-light d-inline-block px-3 mb-4">注文履歴一覧</h2>

      <table class="table table-bordered border-dark">
        <thead class="bg-light text-dark">
          <tr>
            <th style="width: 15%">注文日</th>
            <th style="width: 35%">配送先</th>
            <th>注文商品</th>
            <th style="width: 15%">支払金額</th>
            <th style="width: 15%">ステータス</th>
            <th style="width: 10%">注文詳細</th>
          </tr>
        </thead>
        <tbody>
          <% @orders.each do |order| %>
            <tr>
              <td><%= order.created_at.strftime('%Y/%m/%d') %></td>
              <td>
                〒<%= order.post_code %><br>
                <%= order.address %><br>
                <%= order.name %>
              </td>
              <td>
                <% order.order_details.each do |order_detail| %>
                  <%= order_detail.item.name %><br>
                <% end %>
              </td>
              <td><%= order.total_payment.to_s(:delimited) %>円</td>
              <td><%= order.status_i18n %></td>
              <td>
                <%= link_to '表示する', order_path(order), class: 'btn btn-primary btn-sm' %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  </div>
</div>